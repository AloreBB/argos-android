<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: secrets are bound to this device's Keystore and would be
     undecryptable elsewhere, and server profiles take a minute to re-create. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
